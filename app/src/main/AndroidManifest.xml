<?xml version="1.0" encoding="utf-8"?>
<!-- Notes stay on this phone. Internet is for live dictation (composer mic: audio goes to the speech slot in use,
     Deepgram or Sarvam AI; "On this phone" keeps it on the phone) and for one-time downloads (Opus-MT models and
     offline speech packs from Hugging Face, ML Kit language packs).
     Translation itself runs on the phone; note text is never sent anywhere. ACCESS_NETWORK_STATE lets downloads wait
     for Wi-Fi when "Download on Wi-Fi only" is on (off by default). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:label="Daily Whisper"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyWhisper">
        <!-- configChanges: fold/unfold keeps the same activity, so the composer keeps focus and text. -->
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".NoteActivity" android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".CollectionActivity" android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation" />
        <activity android:name=".SetupActivity" android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".SettingsActivity" android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation" />
        <!-- Background download of the Opus-MT models (JobScheduler; no notification, no foreground service). -->
        <service android:name=".OpusDownloadJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Background download of the offline speech packs (same: JobScheduler, no notification). -->
        <service android:name=".SpeechPackDownloadJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
