<?xml version="1.0" encoding="utf-8"?>
<!-- No permissions at all: notes stay on this phone (no INTERNET). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Daily Whisper"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyWhisper">
        <!-- configChanges: fold/unfold keeps the same activity, so the composer keeps focus and text. -->
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".NoteActivity" android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".SettingsActivity" android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation" />
    </application>
</manifest>
