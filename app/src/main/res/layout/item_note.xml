<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="5dp" android:layout_marginBottom="5dp"
    android:orientation="vertical" android:background="@drawable/bg_card" android:clickable="true" android:focusable="false"
    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="14dp">
    <TextView android:id="@+id/text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/text" android:fontFamily="serif" android:lineSpacingMultiplier="1.3" android:ellipsize="end" />
    <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="12sp" android:letterSpacing="0.02" android:textColor="@color/text2" />
</LinearLayout>
