<?xml version="1.0" encoding="utf-8"?>
<!-- A section label (v0.1.28): letter-spaced small caps, an optional count pill, and a hairline to the right edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="30dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11.5sp" android:textAllCaps="true" android:letterSpacing="0.24" android:maxLines="1"
        android:fontFamily="@font/inter" android:textColor="@color/text2" />
    <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:minWidth="30dp" android:gravity="center" android:visibility="gone"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
        android:textSize="11sp" android:fontFamily="@font/inter" android:textColor="@color/pill_text" />
    <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1px"
        android:layout_marginStart="14dp" android:background="@color/hairline" />
</LinearLayout>
