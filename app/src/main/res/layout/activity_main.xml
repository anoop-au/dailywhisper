<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:id="@+id/mode_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:paddingTop="10dp" android:paddingBottom="2dp">
        <LinearLayout android:id="@+id/mode_pill" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="@drawable/bg_mode_track"
            android:padding="4dp">
            <TextView android:id="@+id/mode_short" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="88dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/mode_short"
                android:textSize="15sp" android:fontFamily="@font/inter" android:textFontWeight="500" android:textColor="@color/text"
                android:clickable="true" android:focusable="true" android:background="@drawable/bg_mode_thumb" />
            <TextView android:id="@+id/mode_long" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="88dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/mode_long"
                android:textSize="15sp" android:fontFamily="@font/inter" android:textFontWeight="500" android:textColor="@color/text"
                android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="24dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textSize="12sp" android:textAllCaps="true"
                android:letterSpacing="0.14" android:fontFamily="@font/inter" android:textColor="@color/accent" />
            <!-- Two lines at most: shrinks a little to fit beside the icons on the Fold's narrow outer screen. -->
            <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textSize="28sp" android:fontFamily="@font/inter" android:textFontWeight="600" android:maxLines="2"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="28sp"
                android:textColor="@color/text" android:letterSpacing="-0.01" />
        </LinearLayout>
        <ImageButton android:id="@+id/btn_theme" android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn" android:contentDescription="@string/theme_toggle" />
        <ImageButton android:id="@+id/btn_search" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_search" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/search" />
        <ImageButton android:id="@+id/btn_settings" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_tune" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/settings" />
        <ImageButton android:id="@+id/btn_more" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_more" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/more" />
    </LinearLayout>

    <!-- Multi-select mode (long-press a note → Select): replaces the header above. -->
    <LinearLayout android:id="@+id/select_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="18dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/select_cancel" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_close" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/cancel" />
        <TextView android:id="@+id/select_count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="22sp" android:fontFamily="@font/inter" android:maxLines="1"
            android:ellipsize="end" android:textColor="@color/text" />
        <Button android:id="@+id/select_all" android:layout_width="wrap_content" android:layout_height="44dp"
            android:text="@string/select_all" android:textAllCaps="false" android:textSize="15sp"
            android:fontFamily="@font/inter" android:textColor="@color/accent"
            android:background="@drawable/bg_icon_btn" android:paddingStart="12dp" android:paddingEnd="12dp" />
        <ImageButton android:id="@+id/select_delete" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_delete" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/delete_selected" />
    </LinearLayout>

    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="4dp"
        android:background="@drawable/bg_search" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="11dp" android:paddingBottom="11dp" android:hint="@string/search_hint"
        android:inputType="text" android:imeOptions="actionSearch" android:textSize="16sp"
        android:textColor="@color/text" android:visibility="gone" android:importantForAutofill="no" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <!-- Notes sit directly on the page background: no panel behind them. -->
        <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="false" android:clipToPadding="false" android:overScrollMode="ifContentScrolls"
            android:scrollbarStyle="outsideOverlay">
            <LinearLayout android:id="@+id/notes" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp" />
        </ScrollView>
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:padding="40dp" android:text="@string/empty"
            android:textSize="19sp" android:lineSpacingMultiplier="1.4" android:fontFamily="@font/inter"
            android:textStyle="italic" android:textColor="@color/text2" android:visibility="gone" />
        <LinearLayout android:id="@+id/undo_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:layout_margin="12dp" android:background="@drawable/bg_toast"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp"
            android:paddingEnd="6dp" android:elevation="6dp" android:visibility="gone">
            <TextView android:id="@+id/undo_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/deleted" android:textColor="@color/toast_text" android:textSize="15sp" />
            <Button android:id="@+id/undo_btn" android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="@string/undo" android:textAllCaps="false" android:textSize="15sp"
                android:fontFamily="@font/inter" android:textColor="@color/toast_action"
                android:background="@drawable/bg_icon_btn" android:paddingStart="16dp" android:paddingEnd="16dp" />
        </LinearLayout>
        <ImageButton android:id="@+id/fab" android:layout_width="56dp" android:layout_height="56dp"
            android:layout_gravity="bottom|end" android:layout_margin="18dp"
            android:src="@drawable/ic_add" android:background="@drawable/bg_fab"
            android:contentDescription="@string/start_session" android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom composer: a plain, accessibility-editable EditText so Vion's ACTION_SET_TEXT/PASTE lands here. -->
    <LinearLayout android:id="@+id/composer_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="4dp" android:layout_marginBottom="10dp"
        android:background="@drawable/bg_composer" android:elevation="2dp"
        android:orientation="horizontal" android:gravity="bottom" android:padding="6dp">
        <com.anoop.dailywhisper.ComposerEditText android:id="@+id/composer"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:background="@null" android:paddingStart="14dp" android:paddingEnd="8dp"
            android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="center_vertical|start"
            android:hint="@string/composer_hint" android:textColor="@color/text" android:lineSpacingMultiplier="1.2"
            android:inputType="textMultiLine|textCapSentences|textAutoCorrect" android:maxLines="8"
            android:scrollbars="vertical" android:importantForAutofill="no" />
        <ImageButton android:id="@+id/mic" android:layout_width="44dp" android:layout_height="48dp"
            android:layout_marginEnd="4dp" android:src="@drawable/ic_mic" android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/live_dictation" />
        <ImageButton android:id="@+id/send" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_send" android:background="@drawable/bg_send" android:contentDescription="@string/save" />
    </LinearLayout>
</LinearLayout>
