<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
        <ImageButton android:id="@+id/back" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_back" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/back" />
        <TextView android:id="@+id/date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="@color/text2" android:maxLines="2" />
        <ImageButton android:id="@+id/edit_toggle" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_edit" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/edit" />
        <ImageButton android:id="@+id/share" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_share" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/share" />
        <ImageButton android:id="@+id/history" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_history" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/history" />
        <ImageButton android:id="@+id/highlight" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_highlight" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/highlight" />
        <ImageButton android:id="@+id/archive" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_archive" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/archive" />
        <ImageButton android:id="@+id/delete" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_delete" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/delete" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="28dp" android:textSize="12sp" android:textAllCaps="true" android:letterSpacing="0.1"
        android:textColor="@color/accent" android:visibility="gone" />
    <TextView android:id="@+id/read_hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="28dp" android:layout_marginTop="2dp" android:textSize="12sp"
        android:textColor="@color/hint" android:text="@string/read_hint" android:visibility="gone" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <EditText android:id="@+id/edit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@null" android:gravity="top|start" android:paddingStart="28dp" android:paddingEnd="28dp"
            android:paddingTop="8dp" android:paddingBottom="48dp" android:textColor="@color/text"
            android:lineSpacingMultiplier="1.35" android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
            android:importantForAutofill="no" android:hint="@string/composer_hint" />
    </ScrollView>
    <!-- Translation result, bottom-sheet style: the original stays above, untouched until you pick Replace. -->
    <LinearLayout android:id="@+id/tr_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="10dp"
        android:orientation="vertical" android:background="@drawable/bg_panel" android:paddingStart="20dp"
        android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="10dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_translate"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/tr_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="13sp" android:textColor="@color/text2" android:maxLines="1"
                android:ellipsize="end" />
            <ImageButton android:id="@+id/tr_close" android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_close" android:background="@drawable/bg_icon_btn" android:contentDescription="@string/close" />
        </LinearLayout>
        <TextView android:id="@+id/tr_note" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" android:textSize="12sp" android:textColor="@color/hint" android:visibility="gone" />
        <ProgressBar android:id="@+id/tr_progress" style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp" android:indeterminate="true" android:indeterminateTint="@color/accent" />
        <com.anoop.dailywhisper.MaxHeightScrollView android:id="@+id/tr_scroll" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/tr_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingEnd="12dp" android:textColor="@color/text"
                android:lineSpacingMultiplier="1.3" android:textIsSelectable="true" android:fontFamily="serif" />
        </com.anoop.dailywhisper.MaxHeightScrollView>
        <LinearLayout android:id="@+id/tr_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="end">
            <Button android:id="@+id/tr_copy" android:layout_width="wrap_content" android:layout_height="44dp"
                android:text="@string/tr_copy" android:textAllCaps="false" android:textColor="@color/accent"
                android:background="@drawable/bg_icon_btn" style="?android:attr/borderlessButtonStyle" />
            <Button android:id="@+id/tr_keep" android:layout_width="wrap_content" android:layout_height="44dp"
                android:text="@string/tr_keep" android:textAllCaps="false" android:textColor="@color/accent"
                android:background="@drawable/bg_icon_btn" style="?android:attr/borderlessButtonStyle" />
            <Button android:id="@+id/tr_replace" android:layout_width="wrap_content" android:layout_height="44dp"
                android:text="@string/tr_replace" android:textAllCaps="false" android:textColor="@color/accent"
                android:background="@drawable/bg_icon_btn" style="?android:attr/borderlessButtonStyle" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
