<?xml version="1.0" encoding="utf-8"?>
<!-- The note screen's reading well (original + translation): the same gold frame as the cards (GoldEdge), 20dp corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><corners android:radius="20dp"/><solid android:color="@color/gilt_glow"/></shape></item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape><corners android:radius="18dp"/><solid android:color="@color/card_80"/><stroke android:width="1dp" android:color="@color/gilt_edge"/></shape>
    </item>
</layer-list>
